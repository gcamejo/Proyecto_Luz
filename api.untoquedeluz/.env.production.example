APP_NAME="Un Toque de Luz API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.untoquedeluz.com.ar
APP_TIMEZONE=America/Argentina/Buenos_Aires
FRONTEND_URL=https://untoquedeluz.com.ar
TRUSTED_PROXIES=

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

LOG_CHANNEL=daily
LOG_DAYS=7
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

FILESYSTEM_DISK=public
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

SANCTUM_STATEFUL_DOMAINS=
SANCTUM_EXPIRATION_MINUTES=43200
SANCTUM_TOKEN_TTL_MINUTES=43200
LEGAL_POLICY_VERSION=borrador-2026-10-23-v1
LEGAL_POLICY_UPDATED_AT=2026-10-23
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_VERIFY_SSL=true
ADMIN_NOTIFICATION_EMAIL=